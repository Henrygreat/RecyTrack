generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum Role {
  OWNER
  ADMIN
  OPERATIONS
  DRIVER
  WAREHOUSE
  CUSTOMER
}

enum CustomerRole {
  CUSTOMER_ADMIN
  CUSTOMER_USER
}

enum CustomerType {
  BUSINESS
  INDIVIDUAL
}

enum CustomerStatus {
  ACTIVE
  ARCHIVED
}

enum CollectionStatus {
  DRAFT
  REQUESTED
  CONFIRMED // Legacy status - migrated to APPROVED, kept for backwards compatibility
  APPROVED
  SCHEDULED
  ASSIGNED
  IN_TRANSIT
  COLLECTED
  RECEIVED
  COMPLETED
  CANCELLED
  EXCEPTION
}

enum CollectionPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CollectionType {
  STANDARD
  SECURE_DATA
  HAZARDOUS
  LARGE_ITEMS
  MIXED
}

enum BookingMode {
  SCHEDULED
  ALTERNATIVE
}

enum AssetStatus {
  EXPECTED // Listed on collection manifest, not yet collected
  COLLECTED // Picked up from customer site
  RECEIVED // Arrived at warehouse, awaiting inspection
  INSPECTION // Being inspected and graded
  QUARANTINED // In quarantine hold
  DATA_ERASURE // Data destruction in progress
  PROCESSING // Being prepared for disposition
  READY // Ready for sale/recycling
  LISTED // Listed for resale
  SOLD // Sold to buyer
  RECYCLED // Sent to recycling partner
  DESTROYED // Certified destruction complete
  RETURNED // Returned to customer
  RELEASED // Released from inventory
}

enum AssetCategory {
  LAPTOP
  DESKTOP
  SERVER
  MONITOR
  MOBILE_PHONE
  TABLET
  PRINTER
  NETWORKING
  STORAGE_DEVICE
  UPS_BATTERY
  PERIPHERAL
  CABLE_ACCESSORY
  OTHER
}

enum PhysicalCondition {
  EXCELLENT // Like new, no visible wear
  GOOD // Minor cosmetic wear only
  FAIR // Moderate wear, fully functional
  POOR // Heavy wear, may affect function
  DAMAGED // Physical damage present
  FOR_PARTS // Not suitable for resale
}

enum FunctionalCondition {
  WORKING // Fully operational
  PARTIAL // Some functions not working
  NOT_WORKING // Does not power on or function
  UNTESTED // Not yet tested
}

enum DataBearingStatus {
  NOT_APPLICABLE // No data storage capability
  NOT_ASSESSED // Not yet checked
  DATA_PRESENT // Contains data, not wiped
  WIPED_STANDARD // Standard data wipe complete
  WIPED_CERTIFIED // Certified erasure with certificate
  PHYSICALLY_DESTROYED // Storage media physically destroyed
}

enum DispositionOutcome {
  PENDING // No disposition decision yet
  RESALE // To be resold
  DONATION // To be donated
  RECYCLE // To be recycled
  DESTROY // To be destroyed
  RETURN // To be returned to customer
}

// ============================================
// PHASE 4.3 & 4.4 ENUMS
// ============================================

enum InspectionStatus {
  DRAFT // Not yet submitted
  SUBMITTED // Submitted for review
  APPROVED // Approved by supervisor
  REJECTED // Rejected, requires revision
}

enum InspectionType {
  RECEIVING // Initial receiving inspection
  PERIODIC // Routine periodic inspection
  PRE_SALE // Pre-sale quality check
  RANDOM // Random quality audit
  QUALITY_CONTROL // QC check
  CUSTOMER_REQUEST // Customer-requested inspection
  POST_REPAIR // After repair/refurbishment
}

enum ConditionGrade {
  A // Excellent - Like new, minimal wear
  B // Good - Light wear, fully functional
  C // Fair - Moderate wear, functional
  D // Poor - Heavy wear, may have issues
  F // Faulty - Non-functional or damaged
}

enum QuarantineReason {
  DAMAGE // Physical damage requiring assessment
  DATA_SECURITY // Data security concern
  INVESTIGATION // Under investigation
  COMPLIANCE // Compliance hold
  CUSTOMER_REQUEST // Customer requested hold
  SUSPECTED_STOLEN // Suspected stolen property
  HAZARDOUS // Hazardous material concern
  OTHER // Other reason
}

enum QuarantineStatus {
  ACTIVE // Currently in quarantine
  RELEASED // Released from quarantine
  DISPOSED // Disposed while in quarantine
}

enum CustodyEventType {
  COLLECTION // Collected from customer site
  VEHICLE_LOADING // Loaded onto vehicle
  VEHICLE_UNLOADING // Unloaded from vehicle
  WAREHOUSE_RECEIPT // Received at warehouse
  INTERNAL_TRANSFER // Moved within warehouse
  INSPECTION_HANDOVER // Handed to inspector
  QUARANTINE_TRANSFER // Moved to/from quarantine
  PROCESSING_HANDOVER // Handed to processor
  EXTERNAL_DISPATCH // Dispatched externally
  FINAL_HANDOVER // Final handover (sale/recycle)
}

enum HandoverStatus {
  PENDING // Awaiting confirmation
  CONFIRMED // Handover confirmed
  REJECTED // Handover rejected
  CANCELLED // Handover cancelled
}

enum CustodyExceptionType {
  MISSING_CUSTODIAN // No custodian assigned
  UNCONFIRMED_HANDOVER // Handover not confirmed in time
  UNEXPECTED_LOCATION // Asset found in unexpected location
  MISSING_RECEIPT // Receipt confirmation missing
  UNAUTHORIZED_TRANSFER // Unauthorized transfer attempted
  CUSTODY_DISCREPANCY // Chain of custody discrepancy
  ASSET_NOT_FOUND // Asset cannot be located
}

enum CustodyExceptionStatus {
  OPEN // Exception is open
  INVESTIGATING // Under investigation
  RESOLVED // Exception resolved
  ESCALATED // Escalated to management
}

// ============================================
// PHASE 4.5 ENUMS
// ============================================

enum StocktakeStatus {
  IN_PROGRESS // Active stocktake session
  PAUSED // Temporarily paused
  PENDING_REVIEW // Completed scanning, awaiting review
  COMPLETED // Fully reconciled and approved
  CANCELLED // Cancelled before completion
}

enum StocktakeItemStatus {
  EXPECTED // Expected at location but not yet scanned
  FOUND // Scanned and matched expected location
  MISSING // Expected but not found after session complete
  UNEXPECTED // Scanned but not expected at this location
  DISCREPANCY // Location mismatch (found elsewhere)
}

// ============================================
// CORE USER & ORGANIZATION MODELS
// ============================================

model User {
  id                     String               @id @default(cuid())
  name                   String?
  email                  String               @unique
  passwordHash           String
  passwordVersion        Int                  @default(1) // Incremented on password change to invalidate JWT sessions
  createdAt              DateTime             @default(now())
  lastLoginAt            DateTime?
  lastActiveAt           DateTime?
  memberships            Membership[]
  customerAccess         CustomerAccess[]
  invitationsSent        CustomerInvitation[] @relation("InvitedBy")
  staffInvitationsSent   StaffInvitation[]    @relation("StaffInvitedBy")
  deactivatedMemberships Membership[]         @relation("DeactivatedBy")
  notifications          Notification[]
  passwordResetTokens    PasswordResetToken[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Profile Information
  tradingName        String?
  registrationNumber String? // Company registration number
  vatNumber          String?
  registeredAddress  String?
  operationalAddress String?
  contactEmail       String?
  contactPhone       String?
  website            String?
  description        String?

  // Branding
  logoUrl        String?
  primaryColor   String? // Hex color e.g. #0f766e
  secondaryColor String? // Hex color
  documentHeader String? // Text for document headers
  documentFooter String? // Text for document footers

  // Operational Settings (JSON for flexibility)
  settings Json? // { timezone, dateFormat, assetPrefix, collectionCutoff, etc. }

  // Notification Preferences (JSON)
  notifications Json? // { newCustomer: true, bookingConfirmed: true, etc. }

  // Relations
  memberships          Membership[]
  customers            Customer[]
  sites                Site[]
  contacts             CustomerContact[]
  zones                CollectionZone[]
  routeDates           RouteDate[]
  collections          Collection[]
  assets               Asset[]
  assetNotes           AssetNote[]
  assetStatusChanges   AssetStatusChange[]
  warehouseLocations   WarehouseLocation[]
  auditLogs            AuditLog[]
  customerInvitations  CustomerInvitation[]
  staffInvitations     StaffInvitation[]
  inspectionTemplates  InspectionTemplate[]
  inspections          Inspection[]
  assetQuarantines     AssetQuarantine[]
  custodyEvents        CustodyEvent[]
  custodyExceptions    CustodyException[]
  stocktakeSessions    StocktakeSession[]
  // Phase 5.1 & 5.2: Data Sanitisation
  storageMedia         StorageMedia[]
  erasureMethods       ErasureMethod[]
  erasureJobs          ErasureJob[]
  destructionJobs      DestructionJob[]
  // Phase 5.3 & 5.4: Certificates & Compliance
  certificates         Certificate[]
  compliancePolicies   CompliancePolicy[]
  complianceExceptions ComplianceException[]
  complianceAudits     ComplianceAudit[]
  complianceEvidence   ComplianceEvidence[]
  // Phase 5.6: Document Management
  documents            Document[]
  // User Notifications
  userNotifications    Notification[]        @relation("OrgNotifications")
}

model Membership {
  id              String       @id @default(cuid())
  userId          String
  organizationId  String
  role            Role
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deactivatedAt   DateTime?
  deactivatedById String?
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deactivatedBy   User?        @relation("DeactivatedBy", fields: [deactivatedById], references: [id])

  @@unique([userId, organizationId])
  @@index([organizationId, role])
  @@index([organizationId, isActive])
}

// ============================================
// CUSTOMER MANAGEMENT (Phase 2)
// ============================================

model Customer {
  id             String         @id @default(cuid())
  organizationId String
  reference      String // Unique customer code e.g. CUST-0001
  name           String
  customerType   CustomerType   @default(BUSINESS)
  companyNumber  String? // UK Company House number
  vatNumber      String? // VAT registration
  email          String? // Main email
  phone          String?
  website        String?
  address        String? // Billing address
  postcode       String?
  status         CustomerStatus @default(ACTIVE)
  notes          String? // Internal notes
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Legacy field - kept for migration compatibility
  contactName String?

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sites          Site[]
  contacts       CustomerContact[]
  collections    Collection[]
  assets         Asset[]
  customerAccess CustomerAccess[]
  invitations    CustomerInvitation[]
  certificates   Certificate[]

  @@unique([organizationId, reference])
  @@unique([id, organizationId])
  @@index([organizationId, name])
  @@index([organizationId, status])
}

model Site {
  id                     String   @id @default(cuid())
  organizationId         String
  customerId             String
  reference              String // Unique site code e.g. SITE-0001
  name                   String
  address                String
  postcode               String
  contactName            String?
  contactPhone           String?
  contactEmail           String?
  collectionInstructions String?
  vehicleAccessNotes     String?
  openingHours           String?
  isActive               Boolean  @default(true)
  isDefault              Boolean  @default(false)
  zoneId                 String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer          @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  zone         CollectionZone?   @relation(fields: [zoneId, organizationId], references: [id, organizationId])
  contacts     CustomerContact[]
  siteAccess   SiteAccess[]
  collections  Collection[]
  assets       Asset[]

  @@unique([organizationId, reference])
  @@unique([id, organizationId])
  @@index([customerId])
  @@index([organizationId, isActive])
}

model CustomerContact {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  siteId         String? // Optional - can be customer-level or site-specific
  name           String
  email          String?
  phone          String?
  jobTitle       String?
  isPrimary      Boolean  @default(false)
  isBilling      Boolean  @default(false)
  isOperational  Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  site         Site?        @relation(fields: [siteId, organizationId], references: [id, organizationId])

  @@unique([id, organizationId])
  @@index([customerId])
  @@index([siteId])
  @@index([organizationId, isPrimary])
}

// ============================================
// CUSTOMER USER ACCESS (Phase 2)
// ============================================

model CustomerAccess {
  id             String       @id @default(cuid())
  userId         String
  customerId     String
  organizationId String
  role           CustomerRole @default(CUSTOMER_USER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer   Customer     @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  siteAccess SiteAccess[]

  @@unique([userId, customerId])
  @@index([customerId])
  @@index([organizationId])
}

model SiteAccess {
  id               String   @id @default(cuid())
  customerAccessId String
  siteId           String
  organizationId   String
  createdAt        DateTime @default(now())

  customerAccess CustomerAccess @relation(fields: [customerAccessId], references: [id], onDelete: Cascade)
  site           Site           @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([customerAccessId, siteId])
  @@index([siteId])
}

model CustomerInvitation {
  id              String       @id @default(cuid())
  organizationId  String
  customerId      String
  siteId          String? // Optional site-specific access
  email           String
  role            CustomerRole @default(CUSTOMER_USER)
  token           String       @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  invitedByUserId String
  createdAt       DateTime     @default(now())

  // Email delivery tracking
  emailSentAt        DateTime? // When email was sent to provider
  emailMessageId     String? // Resend message ID for tracking
  emailDeliveredAt   DateTime? // When provider confirmed delivery
  emailFailedAt      DateTime? // When delivery failed
  emailFailureReason String? // Error message from provider
  lastResendAt       DateTime? // Last time invitation was resent
  resendCount        Int       @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  invitedBy    User         @relation("InvitedBy", fields: [invitedByUserId], references: [id])

  @@index([token])
  @@index([customerId])
  @@index([email])
  @@index([organizationId, expiresAt])
  @@index([emailMessageId])
}

model StaffInvitation {
  id              String    @id @default(cuid())
  organizationId  String
  email           String
  name            String? // Optional name for the invitee
  role            Role      @default(OPERATIONS)
  token           String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  invitedByUserId String
  createdAt       DateTime  @default(now())

  // Email delivery tracking (same as CustomerInvitation)
  emailSentAt        DateTime?
  emailMessageId     String?
  emailDeliveredAt   DateTime?
  emailFailedAt      DateTime?
  emailFailureReason String?
  lastResendAt       DateTime?
  resendCount        Int       @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("StaffInvitedBy", fields: [invitedByUserId], references: [id])

  @@index([token])
  @@index([email])
  @@index([organizationId, expiresAt])
  @@index([emailMessageId])
}

// ============================================
// CUSTOMER SELF-REGISTRATION (Phase 5.8)
// ============================================

enum RegistrationStatus {
  PENDING_VERIFICATION // Email not yet verified
  PENDING_APPROVAL // Email verified, awaiting admin approval
  APPROVED // Approved by admin, customer created
  REJECTED // Rejected by admin
  EXPIRED // Verification token expired
}

model CustomerRegistration {
  id String @id @default(cuid())

  // Company information
  companyName String
  contactName String
  email       String @unique // Must be unique across registrations

  // Password (stored hashed)
  passwordHash String

  // Email verification
  verificationToken   String    @unique
  verificationExpires DateTime
  emailVerifiedAt     DateTime?

  // Registration status
  status RegistrationStatus @default(PENDING_VERIFICATION)

  // Admin approval
  reviewedAt       DateTime?
  reviewedByUserId String?
  reviewedByName   String?
  rejectionReason  String?

  // Link to created customer (after approval)
  createdCustomerId String?
  createdUserId     String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Email delivery tracking
  emailSentAt        DateTime?
  emailMessageId     String?
  emailDeliveredAt   DateTime?
  emailFailedAt      DateTime?
  emailFailureReason String?
  lastResendAt       DateTime?
  resendCount        Int       @default(0)

  @@index([email])
  @@index([verificationToken])
  @@index([status])
  @@index([createdAt])
}

// ============================================
// PASSWORD RESET TOKENS
// ============================================

/// Secure password reset tokens for account recovery.
/// Tokens are stored as cryptographic hashes (SHA-256).
/// Each user can have at most one valid token at a time.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // SHA-256 hash of the token (never store raw token)
  expiresAt DateTime
  createdAt DateTime @default(now())
  usedAt    DateTime? // Set when token is consumed
  ipAddress String?  // IP that requested the reset (for audit)
  userAgent String?  // User agent that requested the reset (for audit)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============================================
// COLLECTION & LOGISTICS MODELS
// ============================================

model CollectionZone {
  id               String       @id @default(cuid())
  organizationId   String
  name             String
  postcodePrefixes String[]
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  routeDates       RouteDate[]
  sites            Site[]

  @@unique([id, organizationId])
}

model RouteDate {
  id             String         @id @default(cuid())
  organizationId String
  zoneId         String
  serviceDate    DateTime       @db.Date
  capacity       Int
  isOpen         Boolean        @default(true)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  zone           CollectionZone @relation(fields: [zoneId, organizationId], references: [id, organizationId])
  collections    Collection[]

  @@unique([zoneId, serviceDate])
  @@unique([id, organizationId])
  @@index([organizationId, serviceDate])
}

model Collection {
  id             String  @id @default(cuid())
  organizationId String
  reference      String
  customerId     String
  siteId         String? // Optional link to site
  routeDateId    String?

  // Booking details
  bookingMode    BookingMode        @default(ALTERNATIVE)
  collectionType CollectionType     @default(STANDARD)
  priority       CollectionPriority @default(NORMAL)
  requestedDate  DateTime?          @db.Date
  scheduledDate  DateTime?          @db.Date
  status         CollectionStatus   @default(DRAFT)

  // Location
  address  String
  postcode String

  // Contact
  contactName  String?
  contactPhone String?
  contactEmail String?

  // Equipment
  equipmentCategories String[] // e.g. ["Laptops", "Desktops", "Monitors"]
  itemEstimate        Int      @default(0)
  actualItemCount     Int?

  // Instructions
  specialHandling      String? // Special handling requirements
  customerInstructions String? // Instructions from customer
  internalNotes        String? // Staff-only notes
  notes                String? // Legacy field, kept for compatibility

  // Assignment
  driverId   String? // Assigned driver user ID
  driverName String? // Driver display name
  vehicleReg String? // Vehicle registration

  // Timestamps
  approvedAt   DateTime?
  assignedAt   DateTime?
  dispatchedAt DateTime? // When driver departed
  collectedAt  DateTime?
  receivedAt   DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?

  // Exception handling
  exceptionReason String?
  exceptionNotes  String?

  // Proof of collection
  signatureName String? // Name of person who signed
  signatureData String? // Base64 signature image
  proofPhotos   String[] // Array of photo URLs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer      Customer                 @relation(fields: [customerId, organizationId], references: [id, organizationId])
  site          Site?                    @relation(fields: [siteId, organizationId], references: [id, organizationId])
  routeDate     RouteDate?               @relation(fields: [routeDateId, organizationId], references: [id, organizationId])
  assets        Asset[]
  statusHistory CollectionStatusChange[]

  @@unique([organizationId, reference])
  @@unique([id, organizationId])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, scheduledDate])
  @@index([driverId, status])
  @@index([customerId, status])
}

model CollectionStatusChange {
  id              String            @id @default(cuid())
  collectionId    String
  organizationId  String
  fromStatus      CollectionStatus?
  toStatus        CollectionStatus
  changedByUserId String?
  changedByName   String?
  reason          String?
  notes           String?
  createdAt       DateTime          @default(now())

  collection Collection @relation(fields: [collectionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([collectionId])
  @@index([organizationId, createdAt])
}

// ============================================
// ASSET & WAREHOUSE MANAGEMENT (Phase 4)
// ============================================

model Asset {
  id             String @id @default(cuid())
  organizationId String

  // Identifiers
  assetTag         String // RecyTrack internal asset ID e.g. RT-000001
  qrCode           String? // QR code data (can be same as assetTag or unique)
  customerAssetTag String? // Customer's own asset tag/barcode

  // Relationships
  collectionId String? // Collection this asset came from (nullable for manual entry)
  customerId   String? // Direct customer link (may differ from collection)
  siteId       String? // Site where asset was collected

  // Classification
  category      AssetCategory @default(OTHER)
  categoryOther String? // Description if category is OTHER
  manufacturer  String?
  model         String?
  serialNumber  String?

  // Device specifications (flexible JSON for different device types)
  specifications Json? // e.g. { processor: "i7", ram: "16GB", storage: "512GB SSD" }

  // Condition assessment
  physicalCondition   PhysicalCondition   @default(FAIR)
  functionalCondition FunctionalCondition @default(UNTESTED)
  conditionGrade      ConditionGrade? // Overall grade (A-F) from inspection
  conditionGradeNotes String? // Rationale for grade
  conditionGradedBy   String? // Inspector who assigned grade
  conditionGradedAt   DateTime? // When grade was assigned
  conditionNotes      String?

  // Data handling
  dataBearingStatus   DataBearingStatus @default(NOT_ASSESSED)
  storageType         String? // e.g. "SSD", "HDD", "NVMe"
  storageCapacity     String? // e.g. "512GB", "1TB"
  dataWipeMethod      String? // e.g. "NIST 800-88", "DoD 5220.22-M"
  dataWipeDate        DateTime?
  dataWipeCertificate String? // URL or reference to certificate
  dataWipeOperator    String? // Name of person who performed wipe

  // Photos
  photos String[] // Array of photo URLs

  // Timestamps
  collectedAt DateTime? // When collected from customer
  receivedAt  DateTime? // When received at warehouse
  inspectedAt DateTime? // When inspection completed
  processedAt DateTime? // When processing completed
  releasedAt  DateTime? // When released from inventory

  // Warehouse location
  warehouseLocationId String?
  binLocation         String? // Specific bin/shelf location

  // Assignment
  assignedOperatorId   String? // User ID of assigned warehouse operator
  assignedOperatorName String? // Display name for quick reference

  // Valuation
  estimatedValue  Decimal? @db.Decimal(10, 2)
  actualSalePrice Decimal? @db.Decimal(10, 2)
  weight          Decimal? @db.Decimal(8, 3) // Weight in kg

  // Disposition
  dispositionOutcome   DispositionOutcome @default(PENDING)
  dispositionDate      DateTime?
  dispositionNotes     String?
  buyerName            String? // If sold
  buyerReference       String? // Buyer's PO or reference
  recyclingPartner     String? // If recycled
  recyclingCertificate String? // Recycling certificate reference

  // Processing status
  status AssetStatus @default(EXPECTED)

  // Metadata
  internalNotes   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?
  createdByName   String?

  // Relations
  // Note: Composite FKs with optional first column and required organizationId must use
  // onDelete: Restrict (not SetNull) because PostgreSQL would try to null both columns,
  // violating the NOT NULL constraint on organizationId.
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  collection        Collection?         @relation(fields: [collectionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  customer          Customer?           @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  site              Site?               @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Restrict)
  warehouseLocation WarehouseLocation?  @relation(fields: [warehouseLocationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  notes             AssetNote[]
  statusHistory     AssetStatusChange[]
  inspections       Inspection[]
  quarantines       AssetQuarantine[]
  custodyEvents     CustodyEvent[]
  custodyExceptions CustodyException[]
  stocktakeItems    StocktakeItem[]
  // Phase 5.1: Storage Media within this asset
  storageMedia      StorageMedia[]

  @@unique([organizationId, assetTag])
  @@unique([id, organizationId])
  @@index([organizationId, serialNumber])
  @@index([organizationId, status])
  @@index([organizationId, category])
  @@index([collectionId])
  @@index([customerId])
  @@index([warehouseLocationId])
  @@index([organizationId, createdAt])
}

model WarehouseLocation {
  id             String   @id @default(cuid())
  organizationId String
  code           String // Location code e.g. "A-01-03" (Aisle A, Row 1, Shelf 3)
  name           String // Friendly name e.g. "Laptop Storage Bay 1"
  description    String?
  locationType   String? // e.g. "Shelf", "Bin", "Pallet", "Cage"
  capacity       Int? // Maximum items this location can hold
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assets            Asset[]
  stocktakeSessions StocktakeSession[]
  // Phase 5.1: Storage Media at this location
  storageMedia      StorageMedia[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, isActive])
}

model AssetNote {
  id              String   @id @default(cuid())
  organizationId  String
  assetId         String
  noteType        String   @default("general") // general, inspection, processing, customer, etc.
  content         String
  attachmentUrl   String? // URL to attached file
  attachmentName  String? // Original filename
  createdByUserId String?
  createdByName   String?
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset        Asset        @relation(fields: [assetId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([assetId])
  @@index([organizationId, createdAt])
}

model AssetStatusChange {
  id              String       @id @default(cuid())
  organizationId  String
  assetId         String
  fromStatus      AssetStatus?
  toStatus        AssetStatus
  changedByUserId String?
  changedByName   String?
  reason          String?
  notes           String?
  createdAt       DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset        Asset        @relation(fields: [assetId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([assetId])
  @@index([organizationId, createdAt])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  entityType     String
  entityId       String
  details        Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}

// ============================================
// PHASE 4.3: INSPECTION MANAGEMENT
// ============================================

model InspectionTemplate {
  id              String        @id @default(cuid())
  organizationId  String
  name            String // Template name e.g. "Laptop Inspection Checklist"
  description     String?
  category        AssetCategory // Which asset category this template applies to
  version         Int           @default(1)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdByUserId String?
  createdByName   String?

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        InspectionTemplateItem[]
  inspections  Inspection[]

  @@unique([organizationId, name, version])
  @@index([organizationId, category, isActive])
}

model InspectionTemplateItem {
  id          String  @id @default(cuid())
  templateId  String
  question    String // Checklist question text
  description String? // Additional guidance
  itemType    String  @default("checkbox") // checkbox, text, select, numeric
  options     Json? // For select type: array of options
  isRequired  Boolean @default(false)
  sortOrder   Int     @default(0)

  template InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, sortOrder])
}

model Inspection {
  id             String           @id @default(cuid())
  organizationId String
  reference      String // Inspection reference e.g. INS-000001
  assetId        String
  templateId     String?
  inspectionType InspectionType   @default(RECEIVING)
  status         InspectionStatus @default(DRAFT)

  // Snapshot of template at time of inspection
  templateSnapshot Json? // Copy of template items when inspection started

  // Inspector details
  inspectorUserId String?
  inspectorName   String?
  inspectionDate  DateTime @default(now())

  // Asset details at time of inspection (snapshot)
  assetCategory     AssetCategory?
  assetManufacturer String?
  assetModel        String?
  assetSerialNumber String?

  // Condition assessment results
  physicalCondition   PhysicalCondition?
  functionalCondition FunctionalCondition?
  conditionGrade      ConditionGrade?
  gradeRationale      String? // Why this grade was assigned

  // Findings
  findings          String? // Inspection findings text
  recommendedAction String? // Recommended next steps
  inspectorComments String? // Additional inspector comments

  // Checklist responses
  checklistResponses Json? // Array of { itemId, response, notes }

  // Photos and attachments
  photos      String[] // Array of photo URLs
  attachments Json? // Array of { url, name, type }

  // Review workflow
  submittedAt      DateTime?
  reviewedByUserId String?
  reviewedByName   String?
  reviewedAt       DateTime?
  reviewNotes      String?
  rejectionReason  String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset        Asset                @relation(fields: [assetId, organizationId], references: [id, organizationId], onDelete: Cascade)
  template     InspectionTemplate?  @relation(fields: [templateId], references: [id])
  revisions    InspectionRevision[]

  @@unique([organizationId, reference])
  @@unique([id, organizationId])
  @@index([assetId])
  @@index([organizationId, status])
  @@index([organizationId, inspectionDate])
  @@index([inspectorUserId])
}

model InspectionRevision {
  id            String   @id @default(cuid())
  inspectionId  String
  revisionNum   Int // Revision number (1, 2, 3...)
  reason        String // Why revision was made
  changes       Json // What was changed
  revisedBy     String? // User ID who made revision
  revisedByName String?
  createdAt     DateTime @default(now())

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@unique([inspectionId, revisionNum])
  @@index([inspectionId])
}

// ============================================
// PHASE 4.3: QUARANTINE MANAGEMENT
// ============================================

model AssetQuarantine {
  id             String           @id @default(cuid())
  organizationId String
  assetId        String
  reason         QuarantineReason
  status         QuarantineStatus @default(ACTIVE)

  // Details
  description     String? // Detailed reason for quarantine
  startDate       DateTime  @default(now())
  expectedEndDate DateTime? // Expected release date
  actualEndDate   DateTime? // Actual release date

  // Assignment
  assignedToUserId String? // Responsible operator
  assignedToName   String?

  // Location during quarantine
  quarantineLocationId String? // Warehouse location for quarantine
  previousLocationId   String? // Where asset was before quarantine

  // Resolution
  resolutionAction String? // What action was taken to resolve
  resolutionNotes  String?
  resolvedByUserId String?
  resolvedByName   String?
  resolvedAt       DateTime?

  // Approval for release
  releaseApprovedBy     String? // User ID who approved release
  releaseApprovedByName String?
  releaseApprovedAt     DateTime?

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?
  createdByName   String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset        Asset        @relation(fields: [assetId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([id, organizationId])
  @@index([assetId])
  @@index([organizationId, status])
  @@index([organizationId, reason])
  @@index([assignedToUserId])
}

// ============================================
// PHASE 4.4: CHAIN OF CUSTODY
// ============================================

model CustodyEvent {
  id             String           @id @default(cuid())
  organizationId String
  reference      String // Custody event reference e.g. COC-000001
  assetId        String
  eventType      CustodyEventType
  handoverStatus HandoverStatus   @default(PENDING)

  // Custodian details
  fromCustodianUserId String? // Previous custodian user ID
  fromCustodianName   String? // Previous custodian name
  fromCustodianType   String? // e.g. "driver", "warehouse_operator", "customer"
  toCustodianUserId   String? // New custodian user ID
  toCustodianName     String? // New custodian name
  toCustodianType     String?

  // Location details
  fromLocationId   String? // Source warehouse location ID
  fromLocationName String? // Source location name or external address
  toLocationId     String? // Destination warehouse location ID
  toLocationName   String? // Destination location name or external address

  // Event details
  eventDate         DateTime @default(now())
  initiatedByUserId String?
  initiatedByName   String?

  // Handover confirmation
  confirmedAt        DateTime?
  confirmedByUserId  String?
  confirmedByName    String?
  confirmationMethod String? // e.g. "signature", "scan", "manual"
  signatureData      String? // Base64 signature if applicable

  // Rejection details
  rejectedAt       DateTime?
  rejectedByUserId String?
  rejectedByName   String?
  rejectionReason  String?

  // Notes and evidence
  notes       String?
  photos      String[] // Array of photo URLs
  attachments Json? // Array of { url, name, type }

  // Link to related records
  collectionId String? // Related collection if applicable
  inspectionId String? // Related inspection if applicable

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset        Asset        @relation(fields: [assetId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([organizationId, reference])
  @@unique([id, organizationId])
  @@index([assetId])
  @@index([organizationId, eventDate])
  @@index([organizationId, handoverStatus])
  @@index([fromCustodianUserId])
  @@index([toCustodianUserId])
}

model CustodyException {
  id             String                 @id @default(cuid())
  organizationId String
  reference      String // Exception reference e.g. EXC-000001
  assetId        String
  exceptionType  CustodyExceptionType
  status         CustodyExceptionStatus @default(OPEN)

  // Exception details
  description      String // Detailed description of the exception
  detectedAt       DateTime @default(now())
  detectedByUserId String?
  detectedByName   String?

  // Related custody event if applicable
  relatedCustodyEventId String?

  // Expected vs actual
  expectedValue String? // What was expected
  actualValue   String? // What was found

  // Investigation
  investigationNotes   String?
  investigatedByUserId String?
  investigatedByName   String?

  // Resolution
  resolutionNotes  String?
  resolvedByUserId String?
  resolvedByName   String?
  resolvedAt       DateTime?

  // Escalation
  escalatedAt       DateTime?
  escalatedToUserId String?
  escalatedToName   String?
  escalationReason  String?

  // Priority
  priority String @default("medium") // low, medium, high, critical

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset        Asset        @relation(fields: [assetId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([organizationId, reference])
  @@unique([id, organizationId])
  @@index([assetId])
  @@index([organizationId, status])
  @@index([organizationId, exceptionType])
  @@index([organizationId, priority])
}

// ============================================
// PHASE 4.5: STOCKTAKE & INVENTORY
// ============================================

model StocktakeSession {
  id             String          @id @default(cuid())
  organizationId String
  reference      String // Session reference e.g. STK-000001
  name           String // Descriptive name e.g. "Q4 2024 Full Stocktake"
  description    String?
  status         StocktakeStatus @default(IN_PROGRESS)

  // Scope of stocktake
  warehouseLocationId String? // Specific location or null for full warehouse
  includeAllLocations Boolean @default(false)

  // Session details
  startedAt   DateTime  @default(now())
  pausedAt    DateTime?
  resumedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  // Operator details
  startedByUserId   String?
  startedByName     String?
  completedByUserId String?
  completedByName   String?

  // Summary counts (updated as session progresses)
  expectedCount   Int @default(0) // Assets expected at start
  scannedCount    Int @default(0) // Unique assets scanned
  foundCount      Int @default(0) // Matched expected
  missingCount    Int @default(0) // Expected but not found
  unexpectedCount Int @default(0) // Not expected but found

  // Reconciliation
  reconciliationNotes String?
  approvedByUserId    String?
  approvedByName      String?
  approvedAt          DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouseLocation WarehouseLocation? @relation(fields: [warehouseLocationId, organizationId], references: [id, organizationId])
  items             StocktakeItem[]

  @@unique([organizationId, reference])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, startedAt])
  @@index([warehouseLocationId])
}

model StocktakeItem {
  id          String              @id @default(cuid())
  stocktakeId String
  assetId     String
  status      StocktakeItemStatus @default(EXPECTED)

  // Expected vs actual
  expectedLocationId   String? // Where asset should be
  expectedLocationCode String?
  actualLocationId     String? // Where asset was found
  actualLocationCode   String?

  // Scan details
  scannedAt       DateTime?
  scannedByUserId String?
  scannedByName   String?
  scanMethod      String? // "camera", "scanner", "manual"

  // For duplicates/errors
  scanCount   Int       @default(0) // How many times scanned
  lastScanAt  DateTime?
  isDuplicate Boolean   @default(false)

  // Notes
  notes           String?
  discrepancyType String? // "location_mismatch", "condition_change", etc.

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocktake StocktakeSession @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  asset     Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([stocktakeId, assetId])
  @@index([stocktakeId, status])
  @@index([assetId])
}

// ============================================
// PHASE 4.6: SCAN EVENT TRACKING
// ============================================

enum ScanEventType {
  LOOKUP // Asset lookup/search
  RECEIVE // Receiving scan
  TRANSFER // Transfer scan
  INSPECT // Inspection scan
  STOCKTAKE // Stocktake scan
  LABEL_PRINT // Label generation
  STATUS_UPDATE // Status change via scan
  BULK_OPERATION // Bulk operation
}

enum ScanOutcome {
  SUCCESS // Scan completed successfully
  NOT_FOUND // Asset not found
  ERROR // Error occurred
  DUPLICATE // Duplicate scan (ignored)
  INVALID // Invalid barcode/QR
}

// ============================================
// PHASE 5.1 & 5.2: DATA SANITISATION ENUMS
// ============================================

enum MediaType {
  HDD // Hard disk drive
  SSD // Solid state drive
  NVME // NVMe solid state drive
  USB // USB flash drive
  MEMORY_CARD // SD card, CF card, etc.
  EMBEDDED // Embedded storage (eMMC, soldered)
  OPTICAL // CD, DVD, Blu-ray
  TAPE // Magnetic tape
  OTHER // Other storage media
}

enum MediaSanitisationStatus {
  NOT_STARTED // No sanitisation attempted
  PENDING_ERASURE // Awaiting erasure
  ERASURE_IN_PROGRESS // Erasure job active
  ERASURE_PASSED // Erasure completed successfully
  ERASURE_FAILED // Erasure failed, may need destruction
  PENDING_DESTRUCTION // Awaiting physical destruction
  DESTRUCTION_IN_PROGRESS // Destruction in progress
  DESTROYED // Physically destroyed
  VERIFIED // Sanitisation verified by supervisor
  EXEMPT // Not data-bearing or exempt from sanitisation
}

enum ErasureMethodCategory {
  CLEAR // Logical overwrite - protects against simple recovery
  PURGE // Advanced overwrite - protects against laboratory recovery
  CRYPTO_ERASE // Cryptographic key destruction
  BLOCK_ERASE // Factory block erase (SSD/NVMe)
  SECURE_ERASE // ATA Secure Erase
  SANITIZE // NVMe Sanitize command
  DEGAUSS // Magnetic field erasure
  OTHER // Other approved method
}

enum ErasureJobStatus {
  PENDING // Job created, not started
  IN_PROGRESS // Erasure running
  PASSED // Erasure completed, verification passed
  FAILED // Erasure failed
  INCONCLUSIVE // Unable to verify outcome
  PENDING_VERIFICATION // Awaiting supervisor verification
  VERIFIED // Supervisor has verified
  CANCELLED // Job cancelled
}

enum DestructionMethod {
  SHRED // Mechanical shredding
  CRUSH // Physical crushing
  DISINTEGRATE // Disintegration
  DEGAUSS // Degaussing (magnetic)
  INCINERATE // Incineration
  MELT // Melting
  DISSOLVE // Chemical dissolution
  PUNCTURE // Drive puncturing
  OTHER // Other approved method
}

enum DestructionStatus {
  SCHEDULED // Destruction scheduled
  IN_PROGRESS // Destruction in progress
  COMPLETED // Destruction completed
  PENDING_VERIFICATION // Awaiting witness/supervisor verification
  VERIFIED // Verified by witness/supervisor
  CANCELLED // Cancelled
}

enum EvidenceType {
  LOG_FILE // Erasure tool log file
  SCREENSHOT // Screenshot of process
  REPORT // Generated report
  PHOTO // Photograph
  VIDEO // Video recording
  CERTIFICATE // External certificate
  HASH_VERIFICATION // Hash verification output
  SERIAL_CONFIRMATION // Serial number confirmation
  OTHER // Other evidence type
}

model ScanEvent {
  id             String @id @default(cuid())
  organizationId String

  // Scan details
  eventType    ScanEventType
  outcome      ScanOutcome
  scannedValue String // Raw scanned value (barcode/QR)

  // Asset link (if found)
  assetId  String?
  assetTag String?

  // Context
  scanMethod      String? // "camera", "scanner", "manual"
  workflowContext String? // Additional context (e.g., stocktake session ID)

  // Operator
  operatorUserId String?
  operatorName   String?

  // Location (if applicable)
  warehouseLocationId String?

  // Error details (if applicable)
  errorMessage String?

  // Timestamps
  scannedAt DateTime @default(now())

  // Do not store PII or sensitive data
  // This is operational data only

  @@index([organizationId, scannedAt])
  @@index([organizationId, eventType])
  @@index([organizationId, outcome])
  @@index([assetId])
  @@index([operatorUserId, scannedAt])
}

// ============================================
// PHASE 5.1: STORAGE MEDIA REGISTER
// ============================================

model StorageMedia {
  id             String @id @default(cuid())
  organizationId String
  reference      String // Media reference e.g. MED-000001

  // Parent asset relationship
  assetId String

  // Media identification
  mediaType    MediaType
  manufacturer String?
  model        String?
  serialNumber String?
  capacity     String? // e.g. "500GB", "1TB", "128GB"
  interface    String? // e.g. "SATA", "NVMe", "USB 3.0", "PCIe"

  // Physical tracking
  warehouseLocationId String?
  binLocation         String?

  // Classification
  isDataBearing         Boolean @default(true)
  containsSensitiveData Boolean @default(false)
  dataClassification    String? // e.g. "CONFIDENTIAL", "INTERNAL", "PUBLIC"

  // Sanitisation status
  sanitisationStatus MediaSanitisationStatus @default(NOT_STARTED)
  sanitisationMethod String? // Method used or required

  // Tracking removable media that become independent
  isRemovable      Boolean   @default(false)
  isIndependent    Boolean   @default(false) // Detached and tracked separately
  detachedAt       DateTime?
  detachedByUserId String?
  detachedByName   String?

  // Verification
  verifiedAt        DateTime?
  verifiedByUserId  String?
  verifiedByName    String?
  verificationNotes String?

  // Notes
  notes String?

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?
  createdByName   String?

  // Relations
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset             Asset              @relation(fields: [assetId, organizationId], references: [id, organizationId], onDelete: Cascade)
  warehouseLocation WarehouseLocation? @relation(fields: [warehouseLocationId, organizationId], references: [id, organizationId])
  erasureJobs       ErasureJob[]
  destructionJob    DestructionJob?
  certificateItems  CertificateItem[]

  @@unique([organizationId, reference])
  @@unique([id, organizationId])
  @@index([assetId])
  @@index([organizationId, sanitisationStatus])
  @@index([organizationId, mediaType])
  @@index([serialNumber])
  @@index([warehouseLocationId])
}

// ============================================
// PHASE 5.1: ERASURE METHOD CONFIGURATION
// ============================================

model ErasureMethod {
  id             String @id @default(cuid())
  organizationId String

  // Method identification
  name        String // e.g. "NIST 800-88 Clear"
  code        String // Short code e.g. "NIST-CLEAR"
  description String?
  category    ErasureMethodCategory

  // Compatibility
  supportedMediaTypes MediaType[] // Which media types this method supports

  // Tool/procedure details
  toolName     String? // e.g. "Blancco", "DBAN", "hdparm"
  toolVersion  String? // Version requirement
  procedureRef String? // Reference to procedure document

  // Requirements
  requiresEvidence      Boolean        @default(true)
  requiredEvidenceTypes EvidenceType[] // Evidence types required
  requiresVerification  Boolean        @default(true)

  // Standards compliance
  complianceStandards String[] // e.g. ["NIST 800-88", "DoD 5220.22-M"]

  // Verification requirements
  verificationMethod   String? // How to verify success
  verificationCriteria String? // Criteria for pass/fail

  // Status
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?
  createdByName   String?

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  erasureJobs  ErasureJob[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@index([organizationId, category])
}

// ============================================
// PHASE 5.1: ERASURE JOB MANAGEMENT
// ============================================

model ErasureJob {
  id             String @id @default(cuid())
  organizationId String
  reference      String // Job reference e.g. ERJ-000001

  // Media being erased
  storageMediaId String

  // Method used
  erasureMethodId String?

  // Snapshot of method used (for audit trail)
  methodName        String
  methodCode        String
  methodCategory    ErasureMethodCategory
  toolUsed          String? // Actual tool/software used
  toolVersion       String? // Actual version used
  procedureFollowed String? // Specific procedure reference

  // Assignment
  assignedTechnicianUserId String?
  assignedTechnicianName   String?
  assignedAt               DateTime?

  // Execution
  status      ErasureJobStatus @default(PENDING)
  startedAt   DateTime?
  completedAt DateTime?

  // Execution details
  executionNotes String? // Notes during execution
  passCount      Int? // Number of overwrite passes (if applicable)

  // Outcome
  outcome         String? // Detailed outcome description
  failureReason   String? // If failed, why
  failureCategory String? // e.g. "HARDWARE_ERROR", "TIMEOUT", "ACCESS_DENIED"

  // Verification
  verificationStatus String? // Result of verification check
  verificationMethod String? // How verification was performed
  verificationResult String? // Detailed verification result
  verifiedAt         DateTime?
  verifiedByUserId   String?
  verifiedByName     String?

  // Supervisor approval
  supervisorApprovalRequired Boolean   @default(true)
  supervisorApprovedAt       DateTime?
  supervisorApprovedByUserId String?
  supervisorApprovedByName   String?
  supervisorNotes            String?

  // Retry tracking
  previousJobId String? // Link to previous attempt if retry
  retryCount    Int     @default(0)
  retryReason   String?

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?
  createdByName   String?

  // Relations
  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  storageMedia  StorageMedia      @relation(fields: [storageMediaId], references: [id], onDelete: Cascade)
  erasureMethod ErasureMethod?    @relation(fields: [erasureMethodId], references: [id])
  evidence      ErasureEvidence[]

  @@unique([organizationId, reference])
  @@index([storageMediaId])
  @@index([organizationId, status])
  @@index([assignedTechnicianUserId])
  @@index([organizationId, createdAt])
}

// ============================================
// PHASE 5.1: ERASURE EVIDENCE
// ============================================

model ErasureEvidence {
  id           String @id @default(cuid())
  erasureJobId String

  // Evidence details
  evidenceType EvidenceType
  fileName     String // Original filename
  fileUrl      String // Storage URL
  fileSize     Int? // Size in bytes
  mimeType     String?

  // Verification
  fileHash      String? // SHA-256 hash of file
  hashAlgorithm String? // e.g. "SHA-256"

  // Metadata
  description String?
  capturedAt  DateTime? // When evidence was captured

  // Timestamps
  uploadedAt       DateTime @default(now())
  uploadedByUserId String?
  uploadedByName   String?

  // Relations
  erasureJob ErasureJob @relation(fields: [erasureJobId], references: [id], onDelete: Cascade)

  @@index([erasureJobId])
  @@index([evidenceType])
}

// ============================================
// PHASE 5.2: PHYSICAL DESTRUCTION
// ============================================

model DestructionJob {
  id             String @id @default(cuid())
  organizationId String
  reference      String // Job reference e.g. DST-000001

  // Media being destroyed
  storageMediaId String @unique // One destruction job per media

  // Reason for destruction
  destructionReason String // Why destruction is required
  reasonCategory    String? // e.g. "ERASURE_FAILED", "CUSTOMER_REQUEST", "COMPLIANCE"

  // Method
  destructionMethod DestructionMethod
  methodDescription String? // Specific method details
  equipmentUsed     String? // e.g. "Proton T-4 Degausser", "SEM Model 0101"

  // Status
  status DestructionStatus @default(SCHEDULED)

  // Schedule
  scheduledDate     DateTime?
  scheduledByUserId String?
  scheduledByName   String?

  // Execution
  startedAt         DateTime?
  completedAt       DateTime?
  performedByUserId String?
  performedByName   String?

  // Location
  destructionLocation String? // Where destruction takes place

  // Execution notes
  executionNotes String?

  // Verification requirement
  requiresWitness Boolean @default(true)
  witnessCount    Int     @default(1) // Number of witnesses required

  // Supervisor verification
  verifiedAt        DateTime?
  verifiedByUserId  String?
  verifiedByName    String?
  verificationNotes String?

  // Media serial number confirmation
  serialNumberConfirmed   Boolean   @default(false)
  serialConfirmedAt       DateTime?
  serialConfirmedByUserId String?
  serialConfirmedByName   String?

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?
  createdByName   String?

  // Relations
  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  storageMedia StorageMedia          @relation(fields: [storageMediaId], references: [id], onDelete: Cascade)
  witnesses    DestructionWitness[]
  evidence     DestructionEvidence[]

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@index([organizationId, scheduledDate])
  @@index([performedByUserId])
}

// ============================================
// PHASE 5.2: DESTRUCTION WITNESSES
// ============================================

model DestructionWitness {
  id               String @id @default(cuid())
  destructionJobId String

  // Witness details
  witnessUserId String?
  witnessName   String
  witnessRole   String? // e.g. "Supervisor", "Customer Representative"
  witnessEmail  String?

  // Confirmation
  confirmedAt   DateTime?
  signatureData String? // Base64 signature if applicable

  // Statement
  witnessStatement String? // Optional witness statement

  // Timestamps
  createdAt DateTime @default(now())

  // Relations
  destructionJob DestructionJob @relation(fields: [destructionJobId], references: [id], onDelete: Cascade)

  @@index([destructionJobId])
  @@index([witnessUserId])
}

// ============================================
// PHASE 5.2: DESTRUCTION EVIDENCE
// ============================================

model DestructionEvidence {
  id               String @id @default(cuid())
  destructionJobId String

  // Evidence details
  evidenceType EvidenceType
  fileName     String
  fileUrl      String
  fileSize     Int?
  mimeType     String?

  // Verification
  fileHash      String?
  hashAlgorithm String?

  // Metadata
  description String?
  capturedAt  DateTime?

  // Timestamps
  uploadedAt       DateTime @default(now())
  uploadedByUserId String?
  uploadedByName   String?

  // Relations
  destructionJob DestructionJob @relation(fields: [destructionJobId], references: [id], onDelete: Cascade)

  @@index([destructionJobId])
  @@index([evidenceType])
}

// ============================================
// PHASE 5.3: CERTIFICATE MANAGEMENT ENUMS
// ============================================

enum CertificateType {
  DATA_ERASURE // Certificate of Data Erasure
  PHYSICAL_DESTRUCTION // Certificate of Physical Data Destruction
  BATCH // Combined batch certificate with itemised outcomes
}

enum CertificateStatus {
  DRAFT // Being prepared
  PENDING_APPROVAL // Awaiting supervisor approval
  ISSUED // Officially issued
  REVOKED // Revoked (with reason)
  SUPERSEDED // Replaced by newer certificate
}

// ============================================
// PHASE 5.4: COMPLIANCE ENUMS
// ============================================

enum CompliancePolicyStatus {
  DRAFT // Being drafted
  PENDING_APPROVAL // Awaiting approval
  ACTIVE // Currently active
  ARCHIVED // No longer active
  SUPERSEDED // Replaced by newer version
}

enum ComplianceExceptionSeverity {
  LOW // Minor issue, informational
  MEDIUM // Moderate issue, needs attention
  HIGH // Serious issue, requires action
  CRITICAL // Blocking issue, immediate action required
}

enum ComplianceExceptionStatus {
  OPEN // Exception is open
  INVESTIGATING // Under investigation
  PENDING_ACTION // Awaiting corrective action
  RESOLVED // Exception resolved
  CLOSED // Closed (with or without action)
  ESCALATED // Escalated to management
}

enum ComplianceExceptionCategory {
  ERASURE_FAILURE // Failed or inconclusive erasure
  MISSING_MEDIA // Storage media unaccounted for
  SERIAL_MISMATCH // Serial number doesn't match records
  MISSING_EVIDENCE // Required evidence not provided
  UNAPPROVED_METHOD // Method not approved for use
  UNVERIFIED_DESTRUCTION // Destruction not verified
  OVERDUE_APPROVAL // Supervisor approval overdue
  CERTIFICATE_ERROR // Incorrect certificate issuance
  EXPIRED_POLICY // Policy review overdue
  CUSTODY_DISCREPANCY // Chain of custody issue
  OTHER // Other compliance issue
}

enum AuditStatus {
  PLANNED // Audit scheduled
  IN_PROGRESS // Audit underway
  PENDING_REVIEW // Findings being reviewed
  COMPLETED // Audit completed
  CANCELLED // Audit cancelled
}

enum AuditFindingSeverity {
  OBSERVATION // Minor observation, no action required
  MINOR // Minor non-conformance
  MAJOR // Major non-conformance
  CRITICAL // Critical non-conformance
}

enum AuditFindingStatus {
  OPEN // Finding is open
  CORRECTIVE_ACTION_REQUIRED // Action needed
  ACTION_IN_PROGRESS // Corrective action underway
  PENDING_VERIFICATION // Awaiting verification
  CLOSED // Finding closed
}

// ============================================
// PHASE 5.3: CERTIFICATE MODEL
// ============================================

model Certificate {
  id             String @id @default(cuid())
  organizationId String

  // Identification
  reference         String // Certificate reference e.g. CERT-000001
  certificateNumber String // Human-readable certificate number
  verificationToken String @unique // Cryptographic token for public verification

  // Type and status
  certificateType CertificateType
  status          CertificateStatus @default(DRAFT)

  // Customer (all items belong to same customer)
  customerId String

  // Issue details
  issueDate      DateTime?
  issuedByUserId String?
  issuedByName   String?

  // Approval workflow
  approvedAt       DateTime?
  approvedByUserId String?
  approvedByName   String?
  approvalNotes    String?

  // Processing summary
  processingStartDate    DateTime? // Earliest processing date
  processingCompleteDate DateTime? // Latest processing completion date
  totalMediaCount        Int       @default(0)
  sanitisationSummary    String? // Brief summary of methods used

  // PDF document
  pdfUrl           String? // URL to stored PDF
  pdfGeneratedAt   DateTime?
  documentChecksum String? // SHA-256 hash of PDF
  templateVersion  String? // Version of template used

  // Revocation
  revokedAt        DateTime?
  revokedByUserId  String?
  revokedByName    String?
  revocationReason String?

  // Supersession
  supersededById     String? // Certificate that replaced this one
  supersededAt       DateTime?
  supersessionReason String?

  // Metadata
  notes String?

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?
  createdByName   String?

  // Relations
  organization     Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer         Customer                     @relation(fields: [customerId, organizationId], references: [id, organizationId])
  items            CertificateItem[]
  events           CertificateEvent[]
  verificationLogs CertificateVerificationLog[]

  @@unique([organizationId, reference])
  @@unique([organizationId, certificateNumber])
  @@index([customerId])
  @@index([organizationId, status])
  @@index([organizationId, certificateType])
  @@index([verificationToken])
  @@index([organizationId, issueDate])
}

// ============================================
// PHASE 5.3: CERTIFICATE ITEMS (for batch)
// ============================================

model CertificateItem {
  id            String @id @default(cuid())
  certificateId String

  // Media/job reference
  storageMediaId   String
  erasureJobId     String?
  destructionJobId String?

  // Snapshot of processing details at certificate creation
  mediaReference String // Storage media reference
  mediaType      String // HDD, SSD, etc.
  serialNumber   String?
  assetTag       String // Parent asset tag

  // Processing details
  processingType   String // "ERASURE" or "DESTRUCTION"
  processingMethod String // Method name used
  processingDate   DateTime
  outcomeStatus    String // PASSED, VERIFIED, etc.

  // Verification details
  verifiedByName String?
  verifiedAt     DateTime?

  // Order in certificate
  sortOrder Int @default(0)

  // Timestamps
  createdAt DateTime @default(now())

  // Relations
  certificate  Certificate  @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  storageMedia StorageMedia @relation(fields: [storageMediaId], references: [id])

  @@index([certificateId])
  @@index([storageMediaId])
}

// ============================================
// PHASE 5.3: CERTIFICATE EVENTS (audit trail)
// ============================================

model CertificateEvent {
  id            String @id @default(cuid())
  certificateId String

  // Event details
  eventType String // CREATED, SUBMITTED, APPROVED, ISSUED, REVOKED, SUPERSEDED, DOWNLOADED, VERIFIED
  eventDate DateTime @default(now())

  // Actor
  actorUserId String?
  actorName   String?
  actorIp     String? // For verification events

  // Details
  details Json? // Additional event-specific details
  notes   String?

  // Relations
  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@index([certificateId])
  @@index([eventType])
  @@index([eventDate])
}

// ============================================
// PHASE 5.3: CERTIFICATE VERIFICATION LOG
// ============================================

model CertificateVerificationLog {
  id            String @id @default(cuid())
  certificateId String

  // Verification details
  verifiedAt DateTime @default(now())
  verifierIp String?
  userAgent  String?

  // Result
  verificationResult String // VALID, REVOKED, SUPERSEDED, NOT_FOUND

  // Relations
  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@index([certificateId])
  @@index([verifiedAt])
}

// ============================================
// PHASE 5.4: COMPLIANCE POLICY
// ============================================

model CompliancePolicy {
  id             String @id @default(cuid())
  organizationId String

  // Identification
  reference   String // Policy reference e.g. POL-001
  title       String
  description String?

  // Version control
  version           Int     @default(1)
  previousVersionId String? // Link to previous version

  // Status
  status CompliancePolicyStatus @default(DRAFT)

  // Ownership
  ownerUserId String?
  ownerName   String?

  // Dates
  effectiveDate DateTime?
  reviewDate    DateTime? // When policy should be reviewed
  expiryDate    DateTime?

  // Content
  policyContent String? // Full policy text or reference
  documentUrl   String? // Link to policy document

  // Approval
  approvedAt       DateTime?
  approvedByUserId String?
  approvedByName   String?

  // Sanitisation procedures this policy approves
  approvedErasureMethods     String[] // List of approved erasure method codes
  approvedDestructionMethods String[] // List of approved destruction methods

  // Compliance standards this policy references
  complianceStandards String[] // e.g. ["UK GDPR", "NIST 800-88"]

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?
  createdByName   String?

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, reference, version])
  @@index([organizationId, status])
  @@index([organizationId, reviewDate])
}

// ============================================
// PHASE 5.4: COMPLIANCE EXCEPTION
// ============================================

model ComplianceException {
  id             String @id @default(cuid())
  organizationId String

  // Identification
  reference   String // Exception reference e.g. CEX-000001
  title       String
  description String

  // Classification
  category ComplianceExceptionCategory
  severity ComplianceExceptionSeverity @default(MEDIUM)
  status   ComplianceExceptionStatus   @default(OPEN)

  // Related records
  assetId          String?
  storageMediaId   String?
  erasureJobId     String?
  destructionJobId String?
  certificateId    String?
  customerId       String?

  // Detection
  detectedAt       DateTime @default(now())
  detectedByUserId String?
  detectedByName   String?

  // Assignment
  assignedToUserId String?
  assignedToName   String?

  // Investigation
  investigationNotes   String?
  investigatedByUserId String?
  investigatedByName   String?

  // Corrective action
  correctiveAction      String?
  correctiveActionDue   DateTime?
  correctiveActionTaken String?
  correctiveCompletedAt DateTime?

  // Resolution
  resolutionNotes  String?
  resolvedByUserId String?
  resolvedByName   String?
  resolvedAt       DateTime?

  // Evidence
  evidenceUrl String?

  // Escalation
  escalatedAt       DateTime?
  escalatedToUserId String?
  escalatedToName   String?
  escalationReason  String?

  // Blocking
  isBlocking Boolean @default(false) // Blocks certificate issuance

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@index([organizationId, severity])
  @@index([organizationId, category])
  @@index([assignedToUserId])
  @@index([storageMediaId])
  @@index([erasureJobId])
  @@index([destructionJobId])
}

// ============================================
// PHASE 5.4: COMPLIANCE AUDIT
// ============================================

model ComplianceAudit {
  id             String @id @default(cuid())
  organizationId String

  // Identification
  reference   String // Audit reference e.g. AUD-000001
  title       String
  description String?
  auditType   String? // e.g. "Internal", "External", "Customer", "Regulatory"

  // Scope
  scope      String? // Description of audit scope
  customerId String? // If customer-specific audit

  // Status
  status AuditStatus @default(PLANNED)

  // Dates
  plannedStartDate DateTime?
  actualStartDate  DateTime?
  plannedEndDate   DateTime?
  actualEndDate    DateTime?

  // Auditor
  auditorUserId       String?
  auditorName         String?
  auditorEmail        String?
  externalAuditor     Boolean @default(false)
  auditorOrganization String?

  // Findings summary
  totalFindings    Int @default(0)
  criticalFindings Int @default(0)
  majorFindings    Int @default(0)
  minorFindings    Int @default(0)
  observations     Int @default(0)

  // Review
  reviewedByUserId String?
  reviewedByName   String?
  reviewedAt       DateTime?
  reviewNotes      String?

  // Closure
  closedByUserId String?
  closedByName   String?
  closedAt       DateTime?
  closureNotes   String?

  // Documents
  reportUrl          String? // Link to audit report
  evidencePackageUrl String? // Link to evidence package

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?
  createdByName   String?

  // Relations
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  findings     AuditFinding[]

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@index([auditorUserId])
  @@index([customerId])
}

// ============================================
// PHASE 5.4: AUDIT FINDING
// ============================================

model AuditFinding {
  id      String @id @default(cuid())
  auditId String

  // Identification
  reference   String // Finding reference within audit e.g. F001
  title       String
  description String

  // Classification
  severity AuditFindingSeverity
  status   AuditFindingStatus   @default(OPEN)

  // Related
  area        String? // Area of non-conformance
  requirement String? // Requirement not met

  // Corrective action
  correctiveActionRequired String?
  correctiveActionDue      DateTime?
  correctiveActionTaken    String?
  actionTakenByUserId      String?
  actionTakenByName        String?
  actionTakenAt            DateTime?

  // Verification
  verifiedByUserId  String?
  verifiedByName    String?
  verifiedAt        DateTime?
  verificationNotes String?

  // Closure
  closedByUserId String?
  closedByName   String?
  closedAt       DateTime?
  closureNotes   String?

  // Evidence
  evidenceUrl String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  audit ComplianceAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@unique([auditId, reference])
  @@index([auditId])
  @@index([severity])
  @@index([status])
}

// ============================================
// PHASE 5.4: COMPLIANCE EVIDENCE (reuses existing patterns)
// ============================================

model ComplianceEvidence {
  id             String @id @default(cuid())
  organizationId String

  // Classification
  category    String // e.g. "ERASURE_REPORT", "DESTRUCTION_EVIDENCE", "POLICY", "TRAINING", "AUDIT"
  title       String
  description String?

  // Linked records (optional)
  assetId          String?
  storageMediaId   String?
  erasureJobId     String?
  destructionJobId String?
  certificateId    String?
  auditId          String?
  policyId         String?
  exceptionId      String?

  // File details
  fileName      String
  fileUrl       String
  fileSize      Int?
  mimeType      String?
  fileHash      String? // SHA-256 hash
  hashAlgorithm String?

  // Access control
  isRestricted Boolean @default(false)
  accessLevel  String? // e.g. "INTERNAL", "CUSTOMER", "AUDITOR"

  // Retention
  retentionYears Int?
  expiresAt      DateTime?

  // Timestamps
  uploadedAt       DateTime @default(now())
  uploadedByUserId String?
  uploadedByName   String?

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, category])
  @@index([storageMediaId])
  @@index([erasureJobId])
  @@index([destructionJobId])
  @@index([certificateId])
  @@index([auditId])
}

// ============================================
// NOTIFICATIONS
// ============================================

enum NotificationType {
  COLLECTION_BOOKING // New collection booking received
  COLLECTION_APPROVED // Collection approved
  COLLECTION_ASSIGNED // Driver assigned to collection
  COLLECTION_STATUS // Collection status change
  ROUTE_CHANGE // Route schedule change
  CUSTOMER_REQUEST // Customer made a request
  ERASURE_COMPLETE // Data erasure completed
  DESTRUCTION_COMPLETE // Physical destruction completed
  COMPLIANCE_EXCEPTION // Compliance exception raised
  APPROVAL_REQUIRED // Approval needed
  CERTIFICATE_ISSUED // Certificate issued
  USER_INVITED // New user invited
  SYSTEM // System notification
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String // Recipient user
  type           NotificationType
  title          String
  message        String
  isRead         Boolean          @default(false)
  readAt         DateTime?

  // Link to related record
  entityType String? // e.g. "Collection", "Asset", "Certificate"
  entityId   String? // ID of related record
  actionUrl  String? // URL to navigate to

  // Metadata
  metadata Json?

  createdAt DateTime @default(now())

  organization Organization @relation("OrgNotifications", fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}

// ============================================
// PHASE 5.6: DOCUMENT MANAGEMENT
// ============================================

enum DocumentCategory {
  POLICY // Company policies
  PROCEDURE // Standard operating procedures
  TEMPLATE // Document templates
  FORM // Blank forms
  CONTRACT // Contracts and agreements
  COMPLIANCE // Compliance documentation
  TRAINING // Training materials
  REPORT // Generated reports
  OTHER // Miscellaneous
}

enum DocumentStatus {
  DRAFT // Not yet approved
  ACTIVE // Current approved version
  ARCHIVED // Superseded by newer version
  DELETED // Soft deleted
}

model Document {
  id             String @id @default(cuid())
  organizationId String

  // Identification
  reference   String // Document reference e.g. DOC-00001
  title       String
  description String?

  // Classification
  category DocumentCategory
  status   DocumentStatus   @default(DRAFT)
  tags     String[] // Free-form tags for filtering

  // Version control
  version          Int     @default(1)
  parentDocumentId String? // Link to parent document (for versioning)
  isCurrentVersion Boolean @default(true)

  // File details
  fileName String
  fileUrl  String
  fileSize Int? // Size in bytes
  mimeType String?
  fileHash String? // SHA-256 hash for integrity

  // Ownership & approval
  ownerUserId      String?
  ownerName        String?
  approvedAt       DateTime?
  approvedByUserId String?
  approvedByName   String?

  // Review cycle
  effectiveDate DateTime? // When document becomes effective
  reviewDate    DateTime? // When document should be reviewed
  expiryDate    DateTime? // When document expires

  // Access control
  isRestricted Boolean @default(false)
  allowedRoles Role[] // Roles that can view this document (empty = all)

  // Timestamps
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  uploadedByUserId String?
  uploadedByName   String?

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentDocument Document?    @relation("DocumentVersions", fields: [parentDocumentId], references: [id])
  versions       Document[]   @relation("DocumentVersions")

  @@unique([organizationId, reference, version])
  @@index([organizationId, category])
  @@index([organizationId, status])
  @@index([organizationId, isCurrentVersion])
  @@index([parentDocumentId])
}
